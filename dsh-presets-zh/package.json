{
  "name": "@zhiqiangme/dsh-presets-zh",
  "version": "26.10.31",
  "description": "提供中文标准、中文 PTC、中文极简和中文创造四种预设，各模式可独立配置。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "agent-preset",
    "chinese",
    "presets-zh"
  ],
  "author": "zhiqiangme",
  "homepage": "https://github.com/zhiqiangme/dsh-plugins/tree/main/dsh-presets-zh#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhiqiangme/dsh-plugins.git",
    "directory": "dsh-presets-zh"
  },
  "bugs": {
    "url": "https://github.com/zhiqiangme/dsh-plugins/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "icon": "icons/minimal-prompt.svg",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "icons",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    "./context": "./lib/context.js",
    "./prompt": "./lib/prompt.js",
    "./client": "./lib/client.js",
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
