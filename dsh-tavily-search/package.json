{
  "name": "dsh-tavily-search",
  "version": "0.2.0",
  "private": true,
  "description": "用 Tavily 给 DSH 的网页搜索供数：在 DSH 进程内提供 127.0.0.1:8787/v1 搜索接口，API Key 存在 DSH 凭据库。",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "serve": "node lib/cli.js",
    "print-config": "node lib/cli.js --print-config"
  },
  "license": "MIT"
}
